# ── Ethra site repo — ignore rules ─────────────────────────
# Build tooling inside the Azgaar map source (never tracked)
static/maps/azgaar_src/node_modules/
static/maps/azgaar_src/dist/

# Python
__pycache__/
*.pyc

# OS / editor junk
Thumbs.db
desktop.ini
*.swp

# Local secrets — never commit credentials
.git-credentials

# Runtime artifacts
server_stdout.log
server_8791.log
pages_test.log
pages_test_8793.log
ci_log.txt
backups/

# Static Pages build output (regenerated by tools/export_static.py)
_pages/

# Superseded art / legacy viewers — kept locally for history, never shipped
_archive/

# Derived SQLite index (regenerable via: python ethra_index.py build)
ethra.db
ethra.db-wal
ethra.db-shm

# Raw workshop files — directions and drafts never leave Nazarick
raw/

# QA/backup debris that must never be committed
content/story/*.backup_*
content/story/*.bak_*
content/story/*.preview
tmp_render.html

server_stdout.log
tools/server.pid
